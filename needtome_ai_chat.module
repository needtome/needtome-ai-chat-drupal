<?php

/**
 * @file
 * Hooks for the NeedToMe AI Chat module.
 */

use Drupal\needtome_ai_chat\Common\WidgetTag;

require_once __DIR__ . '/src/Common/autoload.php';

/**
 * Implements hook_page_attachments().
 */
function needtome_ai_chat_page_attachments(array &$attachments): void {
  $container = \Drupal::getContainer();
  if ($container->get('router.admin_context')->isAdminRoute()) {
    return;
  }
  $request = $container->get('request_stack')->getCurrentRequest();
  if (!$request || $request->getRequestFormat() !== 'html') {
    return;
  }
  $accept = strtolower((string) $request->headers->get('Accept', ''));
  if ($accept !== '' && !str_contains($accept, 'text/html') && !str_contains($accept, '*/*')) {
    return;
  }

  $host = $container->get('needtome_ai_chat.host');
  $lang = $container->get('language_manager')->getCurrentLanguage()->getId();
  $options = (new WidgetTag())->options($host, $lang);
  if ($options === NULL) {
    return;
  }
  $extensionPath = $container->get('extension.list.module')->getPath('needtome_ai_chat');
  $loader = $container->get('file_url_generator')->generateAbsoluteString($extensionPath . '/assets/aiwc-loader.js');
  $json = json_encode($options, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
  if (!is_string($json)) {
    return;
  }

  $attributes = [
    'src' => $loader,
    'defer' => TRUE,
    'data-aiworker-chat-options' => $json,
  ];
  if ($container->get('module_handler')->moduleExists('csp') && $container->has('csp.nonce')) {
    $nonce = $container->get('csp.nonce')->getValue();
    if (is_string($nonce) && $nonce !== '') {
      $attributes['nonce'] = $nonce;
    }
  }
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => $attributes,
    ],
    'needtome_ai_chat_widget',
  ];
  $attachments['#cache']['tags'][] = 'needtome_ai_chat_widget';
  $attachments['#cache']['contexts'][] = 'languages:language_interface';

}

/**
 * Implements hook_csp_policy_alter().
 */
function needtome_ai_chat_csp_policy_alter($policy, $response): void {
  $container = \Drupal::getContainer();
  if (!$container->get('module_handler')->moduleExists('csp') || !is_object($policy) || !method_exists($policy, 'appendDirective')) {
    return;
  }
  $request = $container->get('request_stack')->getCurrentRequest();
  $adminContext = $container->get('router.admin_context')->isAdminRoute();
  $adminPreview = $adminContext && $request && $request->attributes->get('_route') === 'needtome_ai_chat.admin';
  if ($adminContext && !$adminPreview) {
    return;
  }
  if (!$request) {
    return;
  }
  $host = $container->get('needtome_ai_chat.host');
  $widgetTag = new WidgetTag();
  if (!$adminPreview) {
    if ($request->getRequestFormat() !== 'html') {
      return;
    }
    $accept = strtolower((string) $request->headers->get('Accept', ''));
    if ($accept !== '' && !str_contains($accept, 'text/html') && !str_contains($accept, '*/*')) {
      return;
    }
    $lang = $container->get('language_manager')->getCurrentLanguage()->getId();
    if ($widgetTag->options($host, $lang) === NULL) {
      return;
    }
  }
  $sources = $widgetTag->cspSources($host->base());
  foreach ($sources as $directive => $values) {
    foreach ($values as $value) {
      $policy->appendDirective($directive, $value);
    }
  }
}

/**
 * Implements hook_cron().
 */
function needtome_ai_chat_cron(): void {
  $config = \Drupal::config('needtome_ai_chat.settings');
  $interval = max(3600, (int) $config->get('sync_interval'));
  $state = \Drupal::state();
  $now = \Drupal::time()->getRequestTime();
  $store = \Drupal::keyValue('needtome_ai_chat');
  $ids = $store->get('chat_registry', ['chat1']);
  $manualDue = FALSE;
  foreach (is_array($ids) ? $ids : ['chat1'] as $id) {
    $key = $id === 'chat1' ? 'sync_state' : 'chat:' . $id . ':sync_state';
    $sync = $store->get($key, []);
    $request = is_array($sync) ? ($sync['manual_request'] ?? NULL) : NULL;
    $next = is_array($request) && !empty($request['next_attempt_at']) ? strtotime((string) $request['next_attempt_at']) : FALSE;
    if (is_array($request) && (!$next || $next <= $now)) {
      $manualDue = TRUE;
      break;
    }
  }
  if (!$manualDue && $now - (int) $state->get('needtome_ai_chat.last_enqueued', 0) < $interval) {
    return;
  }
  \Drupal::service('queue')->get('needtome_ai_chat_sync')->createItem(['pages' => TRUE, 'products' => TRUE]);
  $state->set('needtome_ai_chat.last_enqueued', $now);
}
