<?php

/**
 * @file
 * Install and uninstall hooks for the NeedToMe AI Chat module.
 */

use Drupal\needtome_ai_chat\DrupalUninstall;

/**
 * Implements hook_install().
 */
function needtome_ai_chat_install(): void {
  $store = \Drupal::keyValue('needtome_ai_chat');
  $defaults = [
    'widget_options' => ['enabled' => FALSE, 'load' => 'interaction'],
    'sync_options' => [
      'pages' => [
        'enabled' => TRUE,
        'sources' => ['bundles' => []],
      ],
      'products' => ['enabled' => FALSE],
    ],
  ];
  foreach ($defaults as $key => $value) {
    if (!$store->has($key)) {
      $store->set($key, $value);
    }
  }
  $state = \Drupal::state();
  if ($state->get('needtome_ai_chat.last_enqueued') === NULL) {
    $state->set('needtome_ai_chat.last_enqueued', 0);
  }
}

/**
 * Implements hook_uninstall().
 */
function needtome_ai_chat_uninstall(): void {
  DrupalUninstall::run(
    \Drupal::service('needtome_ai_chat.host'),
    \Drupal::service('needtome_ai_chat.oauth'),
    \Drupal::keyValue('needtome_ai_chat'),
    \Drupal::service('queue')->get('needtome_ai_chat_sync'),
    \Drupal::state(),
    \Drupal::service('cache_tags.invalidator'),
  );
}
